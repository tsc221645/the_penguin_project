{
  "name": "the-penguin-project",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "check": "npm run validate:content && npm run typecheck && npm run lint && npm run test",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:release": "tsx scripts/validate-release.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.5",
    "@types/three": "^0.187.0",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "leaflet": "^1.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
